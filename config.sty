% Tampilkan pengganti yang rapi jika aset gambar opsional belum tersedia.
\newcommand{\gambarpengganti}[1]{%
  \IfFileExists{#1}{\includegraphics[width=95mm]{#1}}{%
    \begin{tikzpicture}
      \node[draw=abugelap,text=abugelap,minimum width=95mm,
        minimum height=50mm,align=center,font=\arialfont\small]
      {Gambar dokumentasi\\belum tersedia};
    \end{tikzpicture}}}

\newcommand{\gbr}[2]{%
  \begin{figure}[H]\centering
    \gambarpengganti{figure/#1.png}
    \caption{#2}
  \end{figure}}
\newcommand{\topik}[1]{\par\vspace{8pt}{\bfseries #1}\par\vspace{2pt}}



